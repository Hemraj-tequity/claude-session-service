# Postgres connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/claude_sessions?schema=public"

# HTTP server
PORT=3000
NODE_ENV=development

# Comma-separated tool allow/deny lists passed to the Agent SDK.
# Never blocks on interactive approval (headless) - access is governed purely by these lists.
ALLOWED_TOOLS=Read,Grep,Glob
DISALLOWED_TOOLS=

# Optional system prompt appended to the Agent SDK's default preset.
SYSTEM_PROMPT=

# How long an idle, unattached session stays resident in memory before its
# underlying `claude` subprocess is evicted (still resumable afterward).
SESSION_IDLE_EVICT_MS=600000

# SSE keep-alive heartbeat interval while a session is idle but attached.
SSE_HEARTBEAT_MS=15000

# Optional per-turn cost cap (USD) forwarded to the Agent SDK as maxBudgetUsd.
# Leave unset for no cap. Enforced by the SDK after a turn completes, not
# pre-flight, so treat it as a backstop rather than a hard guarantee.
SESSION_MAX_BUDGET_USD=

LOG_LEVEL=info

# Optional CORS origin. Leave unset to disable CORS entirely (same-host access assumed).
CORS_ORIGIN=
