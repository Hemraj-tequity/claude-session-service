# Postgres connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/claude_sessions?schema=public"

# HTTP server
PORT=3000
NODE_ENV=development

# Comma-separated tool allow list passed to the Agent SDK.
# Never blocks on interactive approval (headless) - access is governed purely by this list.
ALLOWED_TOOLS=Read,Grep,Glob

LOG_LEVEL=info

# Supabase project URL and service-role key (required). Used to persist every
# session's generated project files in Supabase Storage, since the service's
# own filesystem is ephemeral and wiped on every deploy/restart. The
# service-role key is used server-side only - never expose it to a client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket that holds one folder per session (<bucket>/<sessionId>/...).
# Must already exist in the Supabase project.
SUPABASE_STORAGE_BUCKET=projects

# Local scratch directory Claude actually works in; synced to/from
# SUPABASE_STORAGE_BUCKET around each session's lifetime. Defaults to the OS
# temp dir, so it's safe to leave unset.
WORKSPACE_ROOT=/tmp/claude-workspaces
